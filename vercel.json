{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//": "LANX is a Windows desktop app, not a web service. The only thing Vercel hosts is the download page in website/. No build, no install: the folder is served as it is. (Setting Root Directory = website in Vercel does the same thing; this file makes it work without that setting.)",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "website",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download",
      "destination": "/files/LANX-Setup-2.6.0.exe",
      "permanent": false
    },
    {
      "source": "/latest",
      "destination": "/files/LANX-Setup-2.6.0.exe",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/files/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
