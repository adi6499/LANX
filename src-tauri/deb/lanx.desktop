[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
Keywords=chat;messenger;LAN;office;files;
Actions=restart;

[Desktop Action restart]
Name=Restart LANX
Exec={{exec}} --restart
