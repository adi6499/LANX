[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
Keywords=chat;messenger;LAN;office;files;
Actions=restart;fastgraphics;safegraphics;

[Desktop Action restart]
Name=Restart LANX
Exec={{exec}} --restart

[Desktop Action fastgraphics]
Name=Open with the graphics chip (smoother)
Exec={{exec}} --restart --fast-graphics

[Desktop Action safegraphics]
Name=Open without the graphics chip (if the window stays blank)
Exec={{exec}} --restart --safe-graphics
