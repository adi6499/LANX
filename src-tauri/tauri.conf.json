{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LANX",
  "version": "1.2.8",
  "identifier": "com.lanx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LANX — Local Network Messenger",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LANX",
    "copyright": "© 2026 LANX",
    "category": "Productivity",
    "shortDescription": "LANX — office messenger and file sharing over your local network",
    "longDescription": "LANX lets computers on the same office network chat and send files of any size to each other, encrypted end to end, with no internet or server needed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "headerImage": "./windows/installer-header.bmp",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
