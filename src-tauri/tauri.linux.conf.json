{
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "net",
        "priority": "optional",
        "postInstallScript": "deb/postinst.sh",
        "desktopTemplate": "deb/lanx.desktop"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ],
        "release": "1",
        "desktopTemplate": "deb/lanx.desktop"
      }
    }
  }
}
